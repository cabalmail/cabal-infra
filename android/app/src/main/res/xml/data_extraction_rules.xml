<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup, no device-to-device transfer. Cached mail is
     refetchable, auth tokens will live in Keystore-backed storage that does
     not survive restore anyway, and the plan's nav-state clientId must be
     unique per install (docs/1.x/android-client-plan.md, "Resume cursor"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
