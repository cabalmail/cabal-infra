#!/usr/bin/env bash
#
# Regenerate every Cabalmail logo derivative from the single authoritative
# vector at vector/cabalmail-logo.svg. Nothing under the "generated" paths
# below is ever hand-edited: edit the source vector (or a constant in this
# script) and re-run. One command regenerates all Apple icons, the React
# client favicon/logo set, the docs images, and the front-door favicon.
#
#   scripts/generate-logo-assets            # regenerate everything
#   scripts/generate-logo-assets --help     # usage + inventory
#
# Reproducibility
# ---------------
# The art is font-free vector geometry, so a version-pinned resvg renders
# byte-identical PNGs on macOS (local regen) and linux (CI). resvg emits
# clean sRGB PNGs with no ICC profile and no timestamp chunk. Every raster is
# then run through a version-pinned oxipng (bundled libdeflate -> deterministic
# across platforms) which strips all ancillary chunks and drops the alpha
# channel on fully-opaque icons (App Store forbids alpha on opaque app icons),
# while keeping true transparency for the tinted / visionOS / silhouette
# assets. Both tools are pinned, so re-running produces byte-identical output.
#
# resvg + oxipng are the canonical pipeline. If resvg cannot be fetched the
# script falls back to rsvg-convert -> inkscape -> ImageMagick (density 384),
# which render correctly but are NOT guaranteed byte-identical to the
# committed output. If oxipng cannot be fetched the rasters are left
# unoptimized (opaque icons keep an alpha channel) with a warning.
#
# Placement + palette come straight from vector/cabalmail-logo.svg's handoff
# spec and are reproduced exactly - see PLACEMENT and the color constants.

set -euo pipefail

# --------------------------------------------------------------------------
# Constants (from the design handoff — see vector/README.md)
# --------------------------------------------------------------------------

# Optically-centered placement of the 384-unit native glyph on the 1024
# canvas: geometric center (tx 104.8, ty 145.52) with a -10px x correction
# so the single-tangent C-disc and the flat-edged M read as centered. Do not
# re-derive by eye — this string is the spec.
readonly PLACEMENT="translate(94.8 145.52) scale(2.036)"

# Brand color tokens.
readonly FOREST="#2E5235"       # primary green
readonly FOREST_DEEP="#1E3A24"  # secondary green (visionOS front layer)
readonly PARCHMENT="#E8DFC8"    # secondary light; dark-mode glyph

# Icon-backplate gradient tones. These are tints/shades of the cream and ink
# tokens used only for the app-icon backplates; they match the design
# handoff's reference treatments exactly.
readonly LIGHT_TOP="#FAF4E4"    LIGHT_BOTTOM="#EFE2C0"
readonly DARK_TOP="#17261B"     DARK_BOTTOM="#0A130D"
readonly PLATE_0="#FAF4E4"      PLATE_1="#EFE2C0"      PLATE_2="#D9C890"

# Glyph size on the Liquid Glass .icon canvas. 1.0 runs the wide mark nearly
# edge-to-edge; 0.72 read undersized next to system icons on a real Home
# Screen / Dock. 0.85 matches neighboring icons' visual weight while keeping
# the M's right edge clear of the squircle mask (0.90 crowds it).
readonly ICON_GLYPH_SCALE="0.95"

# The docs masthead logo is a solid silhouette (composited over a dark
# animated plate by docs/_sass) — black preserves its established look.
readonly MASK_INK="#000000"

readonly BANNER="GENERATED by scripts/generate-logo-assets from vector/cabalmail-logo.svg. DO NOT EDIT."

# --------------------------------------------------------------------------
# Locations
# --------------------------------------------------------------------------

REPO_ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
readonly REPO_ROOT
readonly SOURCE="${REPO_ROOT}/vector/cabalmail-logo.svg"
readonly DERIVED="${REPO_ROOT}/vector/derived"
readonly CACHE="${REPO_ROOT}/.cache/logo-tools"

log() { printf '[logo-gen] %s\n' "$*"; }
die() { printf '[logo-gen] ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
generate-logo-assets — regenerate all Cabalmail logo derivatives from
                        vector/cabalmail-logo.svg (the single source of truth).

Usage:
  scripts/generate-logo-assets [--rasterizer NAME] [--help]

Options:
  --rasterizer NAME   Force a rasterizer: resvg | rsvg-convert | inkscape |
                      magick. Default: pinned resvg (fetched to .cache/),
                      then rsvg-convert, inkscape, magick.
  --help              Show this help.

Regenerated outputs (all committed; never hand-edit):
  Apple — apple/Cabalmail/AppIcon.icon                              (iOS Liquid Glass, Default/Dark)
          apple/CabalmailMac/AppIcon.icon                           (macOS Liquid Glass, Default/Dark)
          apple/Cabalmail/Assets.xcassets/AppIconVision.solidimagestack  (visionOS 3 layers)
          apple/CabalmailWatch/Assets.xcassets/AppIcon.appiconset   (watchOS single 1024)
          apple/{Cabalmail,CabalmailMac}/Assets.xcassets/CabalmailMark.imageset
          apple/CabalmailMac/Assets.xcassets/MenuBarMark.imageset      (menu-bar status item)
  React — react/admin/public/{favicon.svg,favicon.ico,logo192.png,logo384.png,mask.png}
          react/admin/src/assets/logo.svg
  Docs  — docs/logo.png, docs/mask.png
  Site  — front-door/assets/cabalmail-mark.svg
  SVG   — vector/derived/*.svg   (intermediate treatments; render inputs)

Out of scope (intentionally not regenerated):
  front-door/assets/bimi/cabalmail.svg   — BIMI SVG Tiny 1.2 PS profile (distinct constraints)
  react/design_handoff_.../logo.*        — historical design-handoff artifact
EOF
}

# --------------------------------------------------------------------------
# Rasterizer
# --------------------------------------------------------------------------

RASTERIZER=""          # resolved tool name
RESVG_BIN=""           # path to resvg when used
OXIPNG_BIN=""          # path to oxipng when used (empty = optimization skipped)
readonly OXIPNG_VERSION="10.1.1"

resvg_target() {
  local os arch
  os="$(uname -s)"; arch="$(uname -m)"
  case "${os}/${arch}" in
    Linux/x86_64)              echo "linux-x86_64" ;;
    Darwin/arm64|Darwin/aarch64) echo "macos-aarch64" ;;
    Darwin/x86_64)             echo "macos-x86_64" ;;
    *) return 1 ;;
  esac
}

ensure_resvg() {
  # Reuse an already-fetched, verified binary in the cache.
  local target dest
  target="$(resvg_target)" || return 1
  dest="${CACHE}/resvg-0.47.0-${target}"
  if [[ -x "${dest}" ]]; then RESVG_BIN="${dest}"; return 0; fi
  command -v curl >/dev/null 2>&1 || return 1
  mkdir -p "${CACHE}"
  log "fetching pinned resvg (${target}) -> ${dest#"${REPO_ROOT}/"}"
  if "${REPO_ROOT}/.github/scripts/fetch-resvg.sh" "${dest}" "${target}" >/dev/null 2>&1; then
    RESVG_BIN="${dest}"; return 0
  fi
  return 1
}

oxipng_target() {
  local os arch
  os="$(uname -s)"; arch="$(uname -m)"
  case "${os}/${arch}" in
    Linux/x86_64)                 echo "x86_64-unknown-linux-gnu" ;;
    Linux/aarch64|Linux/arm64)    echo "aarch64-unknown-linux-gnu" ;;
    Darwin/arm64|Darwin/aarch64)  echo "aarch64-apple-darwin" ;;
    *) return 1 ;;   # e.g. Intel macOS: no oxipng release
  esac
}

oxipng_sha() {
  case "$1" in
    x86_64-unknown-linux-gnu)  echo "5988392e88fc3d03f562f2d565e5c12a095223ae8bd983576f2aaff2fadf3738" ;;
    aarch64-unknown-linux-gnu) echo "a69c9dbb110463746153bf9b56488a293747e1d90dc1f30d24af3d9615165b98" ;;
    aarch64-apple-darwin)      echo "615a401629b5cc104bdc775ac962abd67ab2f3084f0b3b1ba9c51e9b76c3964f" ;;
    *) return 1 ;;
  esac
}

ensure_oxipng() {
  local target dest sha url tmp member
  target="$(oxipng_target)" || return 1
  dest="${CACHE}/oxipng-${OXIPNG_VERSION}-${target}"
  if [[ -x "${dest}" ]]; then OXIPNG_BIN="${dest}"; return 0; fi
  command -v curl >/dev/null 2>&1 || return 1
  sha="$(oxipng_sha "${target}")" || return 1
  mkdir -p "${CACHE}"
  url="https://github.com/shssoichiro/oxipng/releases/download/v${OXIPNG_VERSION}/oxipng-${OXIPNG_VERSION}-${target}.tar.gz"
  tmp="$(mktemp -d)"; member="oxipng-${OXIPNG_VERSION}-${target}/oxipng"
  log "fetching pinned oxipng (${target}) -> ${dest#"${REPO_ROOT}/"}"
  if ! curl -fsSL -o "${tmp}/oxipng.tar.gz" "${url}"; then rm -rf "${tmp}"; return 1; fi
  if command -v sha256sum >/dev/null 2>&1; then
    echo "${sha}  ${tmp}/oxipng.tar.gz" | sha256sum -c - >/dev/null 2>&1 || { rm -rf "${tmp}"; return 1; }
  else
    echo "${sha}  ${tmp}/oxipng.tar.gz" | shasum -a 256 -c - >/dev/null 2>&1 || { rm -rf "${tmp}"; return 1; }
  fi
  tar -xzf "${tmp}/oxipng.tar.gz" -C "${tmp}" --strip-components=1 "${member}" \
    || { rm -rf "${tmp}"; return 1; }
  install -m 0755 "${tmp}/oxipng" "${dest}"
  rm -rf "${tmp}"
  OXIPNG_BIN="${dest}"
}

# optimize <png> <opaque|alpha>
#   opaque -> allow color-type reduction (drops the alpha channel)
#   alpha  -> keep truecolor RGBA (--nc), only strip metadata + recompress
optimize() {
  [[ -n "${OXIPNG_BIN}" ]] || return 0
  local mode="$2"
  if [[ "${mode}" == "opaque" ]]; then
    # Drop the fully-opaque alpha channel (-> truecolor RGB) but never convert
    # to an indexed palette (--np): the narrow icon-backplate gradients would
    # band badly at <=256 colors.
    "${OXIPNG_BIN}" -o 4 --strip all --np -q "$1"
  else
    # Keep truecolor RGBA (--nc); only recompress and strip metadata.
    "${OXIPNG_BIN}" -o 4 --strip all --nc -q "$1"
  fi
}

select_rasterizer() {
  local forced="${1:-}"
  if [[ -n "${forced}" ]]; then
    case "${forced}" in
      resvg)   ensure_resvg || die "could not fetch pinned resvg"; RASTERIZER="resvg" ;;
      rsvg-convert|inkscape|magick)
        command -v "${forced}" >/dev/null 2>&1 || die "rasterizer not found: ${forced}"
        RASTERIZER="${forced}" ;;
      *) die "unknown rasterizer: ${forced}" ;;
    esac
  elif ensure_resvg; then
    RASTERIZER="resvg"
  elif command -v rsvg-convert >/dev/null 2>&1; then
    RASTERIZER="rsvg-convert"
  elif command -v inkscape >/dev/null 2>&1; then
    RASTERIZER="inkscape"
  elif command -v magick >/dev/null 2>&1; then
    RASTERIZER="magick"
  else
    die "no rasterizer available (need resvg, rsvg-convert, inkscape, or magick)"
  fi

  if [[ "${RASTERIZER}" != "resvg" ]]; then
    log "WARNING: using ${RASTERIZER}; committed bytes are produced with pinned resvg,"
    log "         so output may differ. Prefer resvg for reproducible commits."
  fi
  log "rasterizer: ${RASTERIZER}"

  if ensure_oxipng; then
    log "optimizer: oxipng ${OXIPNG_VERSION}"
  else
    log "WARNING: oxipng unavailable for this host; PNGs left unoptimized"
    log "         (opaque icons keep an alpha channel). CI (linux) owns the"
    log "         canonical bytes; regenerate there if committing from here."
  fi
}

# render <svg> <w> <h> <out> <opaque|alpha>
render() {
  local svg="$1" w="$2" h="$3" out="$4" mode="${5:-alpha}"
  mkdir -p "$(dirname "${out}")"
  case "${RASTERIZER}" in
    resvg)        "${RESVG_BIN}" --width "${w}" --height "${h}" "${svg}" "${out}" ;;
    rsvg-convert) rsvg-convert -w "${w}" -h "${h}" "${svg}" -o "${out}" ;;
    inkscape)     inkscape --export-type=png --export-width="${w}" --export-height="${h}" \
                    --export-filename="${out}" "${svg}" >/dev/null 2>&1 ;;
    magick)       magick -background none -density 384 "${svg}" -resize "${w}x${h}!" \
                    -strip -define png:exclude-chunks=date,time "${out}" ;;
  esac
  optimize "${out}" "${mode}"
}

# --------------------------------------------------------------------------
# Derived SVG treatments (written to vector/derived/)
# --------------------------------------------------------------------------

# Path geometry extracted from the source vector, in document order:
#   PATH1 = C-disc with arrow cutout (fill-rule evenodd)
#   PATH2 = M envelope
PATH1=""; PATH2=""

extract_paths() {
  # Portable (macOS bash 3.2, no mapfile): pull the two <path> d attributes
  # in document order. PATH1 has fill-rule evenodd and comes first.
  [[ -f "${SOURCE}" ]] || die "source vector missing: ${SOURCE}"
  local ds n
  ds="$(grep -oE 'd="[^"]*"' "${SOURCE}" | sed -E 's/^d="//; s/"$//')"
  n="$(printf '%s\n' "${ds}" | grep -c .)"
  [[ "${n}" -eq 2 ]] || die "expected 2 <path> d attributes in source, found ${n}"
  PATH1="$(printf '%s\n' "${ds}" | sed -n '1p')"
  PATH2="$(printf '%s\n' "${ds}" | sed -n '2p')"
}

# svg_open <viewBox> [extra-svg-attrs]
svg_open() {
  printf '<?xml version="1.0"?>\n<!-- %s -->\n<svg xmlns="http://www.w3.org/2000/svg" viewBox="%s"%s>\n' \
    "${BANNER}" "$1" "${2:-}"
}
disc()     { printf '    <path fill-rule="evenodd" d="%s"></path>\n' "${PATH1}"; }
envelope() { printf '    <path d="%s"></path>\n' "${PATH2}"; }

emit_derived() {
  mkdir -p "${DERIVED}"
  local sz=' width="1024" height="1024"'

  # 1. Transparent mark — forest glyph, 1024 canvas (the "derived mark").
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <g fill="%s" transform="%s">\n' "${FOREST}" "${PLACEMENT}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/cabalmail-mark.svg"

  # 1b. Icon-glyph template — solid-ink mark on transparent, 1024 canvas. The
  #     Liquid Glass .icon (see write_icon) recolors this per appearance via
  #     layer fills, so its own color is irrelevant; black is the conventional
  #     template ink. Same geometry/placement as the derived mark.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <g fill="%s" transform="%s">\n' "${MASK_INK}" "${PLACEMENT}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/AppIcon-glyph-mono.svg"

  # 1c. Menu-bar mark — template ink glyph on the 2:1 brand tile (same frame
  #     as the web logo), with a menu-bar-point intrinsic size (32x16) so the
  #     macOS MenuBarExtra status item renders it at menu-bar scale. Template
  #     rendering recolors it per menu-bar appearance; black is conventional
  #     template ink.
  { svg_open "0 80 400 200" ' width="32" height="16"'
    printf '  <g fill="%s">\n' "${MASK_INK}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/menu-bar-mark.svg"

  # 2. Light app-icon art — forest glyph on cream gradient, full-bleed 1024.
  #    Feeds watchOS (single slot), the React logo PNGs, and docs/logo.png.
  #    The macOS/iOS square icons are the Liquid Glass .icon instead, whose
  #    Default/Dark fills come straight from the color constants (see
  #    write_icon), so no separate dark/tinted full-bleed art is rendered.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <defs>\n    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">\n'
    printf '      <stop offset="0" stop-color="%s"></stop>\n' "${LIGHT_TOP}"
    printf '      <stop offset="1" stop-color="%s"></stop>\n' "${LIGHT_BOTTOM}"
    printf '    </linearGradient>\n  </defs>\n'
    printf '  <rect width="1024" height="1024" fill="url(#bg)"></rect>\n'
    printf '  <g fill="%s" transform="%s">\n' "${FOREST}" "${PLACEMENT}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/AppIcon-ios-light.svg"

  # 3. visionOS back — cream radial plate. The back (last) layer must be a
  # fully-opaque 1024 bitmap (actool rejects transparent corners); the system
  # applies the circular mask, so fill the whole canvas rather than a circle.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <defs>\n    <radialGradient id="plate" cx="0.35" cy="0.3" r="0.9">\n'
    printf '      <stop offset="0" stop-color="%s"></stop>\n' "${PLATE_0}"
    printf '      <stop offset="0.6" stop-color="%s"></stop>\n' "${PLATE_1}"
    printf '      <stop offset="1" stop-color="%s"></stop>\n' "${PLATE_2}"
    printf '    </radialGradient>\n  </defs>\n'
    printf '  <rect width="1024" height="1024" fill="url(#plate)"></rect>\n</svg>\n'
  } > "${DERIVED}/AppIcon-visionos-back.svg"

  # 4. visionOS middle — forest C-disc only.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <g fill="%s" transform="%s">\n' "${FOREST}" "${PLACEMENT}"; disc
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/AppIcon-visionos-middle.svg"

  # 5. visionOS front — forest-deep M envelope only.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <g fill="%s" transform="%s">\n' "${FOREST_DEEP}" "${PLACEMENT}"; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/AppIcon-visionos-front.svg"

  # 6. Web favicon — forest glyph on rounded cream plate.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <defs>\n    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">\n'
    printf '      <stop offset="0" stop-color="%s"></stop>\n' "${LIGHT_TOP}"
    printf '      <stop offset="1" stop-color="%s"></stop>\n' "${LIGHT_BOTTOM}"
    printf '    </linearGradient>\n  </defs>\n'
    printf '  <rect width="1024" height="1024" rx="180" ry="180" fill="url(#bg)"></rect>\n'
    printf '  <g fill="%s" transform="%s">\n' "${FOREST}" "${PLACEMENT}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/favicon.svg"

  # 7. In-app web logo — currentColor mark (React inlines this via ?raw). Paths
  # come from the source vector, but the viewBox keeps the app's established
  # 2:1 brand-tile frame (4px vertical pad around the 400x192 glyph) so the
  # Nav / AuthShell logo does not shift size.
  { svg_open "0 80 400 200"
    printf '  <g fill="currentColor">\n'; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/web-logo.svg"

  # 8. front-door favicon — currentColor mark, 1024 canvas.
  { svg_open "0 0 1024 1024" "${sz}"
    printf '  <g fill="currentColor" transform="%s">\n' "${PLACEMENT}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/front-door-mark.svg"

  # 9. Docs masthead — solid silhouette on a 2:1 tile (4px vertical pad).
  { svg_open "0 0 400 200"
    printf '  <g fill="%s" transform="translate(0 -80)">\n' "${MASK_INK}"; disc; envelope
    printf '  </g>\n</svg>\n'; } > "${DERIVED}/mask.svg"

  log "wrote 11 derived SVG treatments -> vector/derived/"
}

# --------------------------------------------------------------------------
# Apple Liquid Glass app icon (.icon bundle, macOS 26 / iOS 26)
# --------------------------------------------------------------------------
#
# The square app icon for macOS and iOS/iPadOS is an Icon Composer `.icon`
# bundle — a folder holding icon.json plus an Assets/ dir. This is the only
# format that carries a per-appearance (Default / Dark) macOS icon: an asset
# catalog's `luminosity` appearances are silently dropped by actool for the
# `mac` idiom (they compile to a legacy, appearance-blind .icns). actool also
# emits the older prerendered fallbacks (.icns on macOS, AppIcon60x60/76x76 on
# iOS) from the same .icon, so the macOS-15 / iOS-18 deployment floors keep a
# valid icon while 26+ gets Liquid Glass.
#
# One shape, recolored per appearance. A single ink glyph template
# (AppIcon-glyph-mono.svg) is placed twice: a forest copy on top (hidden in
# Dark) and a parchment copy beneath. Default shows forest-on-cream, Dark
# reveals parchment-on-ink — mirroring the iOS light/dark artwork. Layer-level
# `fill-specializations` are ignored by the renderer, so the two-layer overlay
# is how a bespoke dark glyph is expressed; only the top-level background fill
# specializes cleanly. visionOS keeps its own layered AppIconVision stack and
# watchOS its single 1024 slot — neither uses this .icon.

# hex_srgb <#RRGGBB> -> "srgb:R,G,B,1.00000" — icon.json fills are 0..1 sRGB.
hex_srgb() {
  python3 -c "import sys; h=sys.argv[1].lstrip('#'); print('srgb:%.5f,%.5f,%.5f,1.00000'%(int(h[0:2],16)/255,int(h[2:4],16)/255,int(h[4:6],16)/255))" "$1"
}

# write_icon <target-source-dir> — (re)write <dir>/AppIcon.icon from constants.
write_icon() {
  local dir="$1/AppIcon.icon"
  rm -rf "${dir}"; mkdir -p "${dir}/Assets"
  install -m 0644 "${DERIVED}/AppIcon-glyph-mono.svg" "${dir}/Assets/Mark.svg"
  local grad='"orientation":{"start":{"x":0.5,"y":0.0},"stop":{"x":0.5,"y":1.0}}'
  cat > "${dir}/icon.json" <<EOF
{
  "fill" : { "linear-gradient" : [ "$(hex_srgb "${LIGHT_TOP}")", "$(hex_srgb "${LIGHT_BOTTOM}")" ], ${grad} },
  "fill-specializations" : [
    { "appearance" : "dark", "value" : { "linear-gradient" : [ "$(hex_srgb "${DARK_TOP}")", "$(hex_srgb "${DARK_BOTTOM}")" ], ${grad} } }
  ],
  "groups" : [
    {
      "layers" : [
        { "image-name" : "Mark.svg", "name" : "Glyph Light", "glass" : true,
          "fill" : { "solid" : "$(hex_srgb "${FOREST}")" },
          "hidden-specializations" : [ { "appearance" : "dark", "value" : true } ],
          "position" : { "scale" : ${ICON_GLYPH_SCALE}, "translation-in-points" : [ 0, 0 ] } },
        { "image-name" : "Mark.svg", "name" : "Glyph Dark", "glass" : true,
          "fill" : { "solid" : "$(hex_srgb "${PARCHMENT}")" },
          "position" : { "scale" : ${ICON_GLYPH_SCALE}, "translation-in-points" : [ 0, 0 ] } }
      ],
      "specular" : true,
      "shadow" : { "kind" : "neutral", "opacity" : 0.5 }
    }
  ],
  "supported-platforms" : { "squares" : "shared" }
}
EOF
}

# --------------------------------------------------------------------------
# favicon.ico assembly (embeds 16/32/48 PNG frames — deterministic)
# --------------------------------------------------------------------------
assemble_ico() {  # assemble_ico <out.ico> <png16> <png32> <png48>
  local out="$1"; shift
  python3 - "$out" "$@" <<'PY'
import struct, sys
out, pngs = sys.argv[1], sys.argv[2:]
frames = []
for p in pngs:
    data = open(p, "rb").read()
    w, h = struct.unpack(">II", data[16:24])
    frames.append((0 if w >= 256 else w, 0 if h >= 256 else h, data))
hdr = struct.pack("<HHH", 0, 1, len(frames))
offset = 6 + 16 * len(frames)
entries, blobs = b"", b""
for w, h, data in frames:
    entries += struct.pack("<BBBBHHII", w, h, 0, 0, 1, 32, len(data), offset)
    blobs += data
    offset += len(data)
open(out, "wb").write(hdr + entries + blobs)
PY
}

# --------------------------------------------------------------------------
# Fan out to every consumer
# --------------------------------------------------------------------------
generate_all() {
  local d="${DERIVED}"
  local vision="${REPO_ROOT}/apple/Cabalmail/Assets.xcassets/AppIconVision.solidimagestack"
  local watch="${REPO_ROOT}/apple/CabalmailWatch/Assets.xcassets/AppIcon.appiconset"
  local pub="${REPO_ROOT}/react/admin/public"

  # --- Apple: square app icon (macOS + iOS/iPadOS) — one Liquid Glass .icon
  #     per target, generated from the shared ink glyph template. This is what
  #     carries the per-appearance Default/Dark macOS icon; see write_icon. The
  #     iOS light/dark/tinted SVGs above still feed watchOS / React / docs. ---
  write_icon "${REPO_ROOT}/apple/Cabalmail"
  write_icon "${REPO_ROOT}/apple/CabalmailMac"

  # --- Apple: watchOS single universal slot (1024, opaque). The system
  #     applies the circular home-screen mask itself, so this is the same
  #     full-bleed light art as iOS; the optically-centered glyph sits well
  #     inside the circle. watchOS has no dark/tinted variants. ---
  render "${d}/AppIcon-ios-light.svg" 1024 1024 "${watch}/AppIcon-watch.png" opaque

  # --- Apple: visionOS layered stack (1024 per layer). The back plate must be
  #     fully opaque; the middle/front glyph layers keep transparency. ---
  render "${d}/AppIcon-visionos-back.svg"   1024 1024 "${vision}/Back.solidimagestacklayer/Content.imageset/Back.png"     opaque
  render "${d}/AppIcon-visionos-middle.svg" 1024 1024 "${vision}/Middle.solidimagestacklayer/Content.imageset/Middle.png" alpha
  render "${d}/AppIcon-visionos-front.svg"  1024 1024 "${vision}/Front.solidimagestacklayer/Content.imageset/Front.png"   alpha

  # --- Apple: shared sidebar mark (template imageset, both catalogs) ---
  install -m 0644 "${d}/cabalmail-mark.svg" "${REPO_ROOT}/apple/Cabalmail/Assets.xcassets/CabalmailMark.imageset/cabalmail-mark.svg"
  install -m 0644 "${d}/cabalmail-mark.svg" "${REPO_ROOT}/apple/CabalmailMac/Assets.xcassets/CabalmailMark.imageset/cabalmail-mark.svg"

  # --- Apple: macOS menu-bar status-item mark (template imageset) ---
  install -m 0644 "${d}/menu-bar-mark.svg" "${REPO_ROOT}/apple/CabalmailMac/Assets.xcassets/MenuBarMark.imageset/menu-bar-mark.svg"

  # --- React client ---
  install -m 0644 "${d}/favicon.svg"  "${pub}/favicon.svg"
  install -m 0644 "${d}/web-logo.svg" "${REPO_ROOT}/react/admin/src/assets/logo.svg"
  render "${d}/AppIcon-ios-light.svg" 192 192 "${pub}/logo192.png" opaque
  render "${d}/AppIcon-ios-light.svg" 384 384 "${pub}/logo384.png" opaque
  render "${d}/mask.svg"              200 100 "${pub}/mask.png"     alpha
  # favicon.ico: rounded plate -> transparent corners, so frames keep alpha.
  local tmp; tmp="$(mktemp -d)"
  render "${d}/favicon.svg" 16 16 "${tmp}/16.png" alpha
  render "${d}/favicon.svg" 32 32 "${tmp}/32.png" alpha
  render "${d}/favicon.svg" 48 48 "${tmp}/48.png" alpha
  assemble_ico "${pub}/favicon.ico" "${tmp}/16.png" "${tmp}/32.png" "${tmp}/48.png"
  rm -rf "${tmp}"

  # --- Repo docs ---
  render "${d}/AppIcon-ios-light.svg" 512 512 "${REPO_ROOT}/docs/logo.png" opaque
  render "${d}/mask.svg"              200 100 "${REPO_ROOT}/docs/mask.png"  alpha

  # --- front-door landing site ---
  install -m 0644 "${d}/front-door-mark.svg" "${REPO_ROOT}/front-door/assets/cabalmail-mark.svg"

  log "regenerated all logo consumers"
}

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------
main() {
  local forced=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --rasterizer) forced="${2:?--rasterizer needs a value}"; shift 2 ;;
      *) die "unknown argument: $1 (see --help)" ;;
    esac
  done

  extract_paths
  emit_derived
  select_rasterizer "${forced}"
  generate_all
  log "done."
}

main "$@"
