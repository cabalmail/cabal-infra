<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store validation requires the App Sandbox. The host app
         needs nothing beyond it: its only actions are showing an explainer
         window and opening Safari's extension settings. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
