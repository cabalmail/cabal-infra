{
  "manifest_version": 3,
  "name": "Cabalmail",
  "version": "__VERSION__",
  "description": "Suggest and adopt per-vendor Cabalmail addresses on sign-up forms, and open Cabalmail links in private windows.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cabalmail"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "permissions": [
    "storage",
    "identity",
    "history"
  ],
  "host_permissions": [
    "https://admin.__CONTROL_DOMAIN__/*",
    "https://*.amazoncognito.com/*"
  ]
}
