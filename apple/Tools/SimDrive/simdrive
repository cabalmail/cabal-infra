#!/bin/bash
# Host-side driver for the SimDrive full-app simulator harness.
#
# SimDrive is an XCUITest that runs as a command REPL: `start` launches
# it against a simulator and blocks until it is listening; `cmd` sends
# one command line and prints the JSON result; `stop` shuts it down.
# See SimDriveUITests/SimDriveTests.swift for the command grammar.
#
# The app under test must already be installed on the simulator —
# use scripts/build-sim.sh for a sign-in-capable build.
#
# Works against iOS and visionOS simulators: the destination platform is
# derived from the device's runtime, and the runner (an iOS test bundle)
# runs on visionOS in compatibility mode.
#
# Usage:
#   simdrive start [device]          start the REPL (device name or UDID;
#                                    default: the booted simulator)
#   simdrive cmd <command line...>   run one command, print the result
#   simdrive pbcopy                  seed the simulator pasteboard from
#                                    stdin (for `cmd cmdv` into secure
#                                    fields — keeps secrets out of
#                                    command files and logs)
#   simdrive stop                    quit the REPL and reap xcodebuild
#
# Environment:
#   SIMDRIVE_DIR   command-exchange directory (default /tmp/simdrive)
#   SIMDRIVE_APP   bundle id to drive (default com.cabalmail.Cabalmail)
set -euo pipefail

cd "$(dirname "$0")"

DIR="${SIMDRIVE_DIR:-/tmp/simdrive}"
APP="${SIMDRIVE_APP:-com.cabalmail.Cabalmail}"

log() { echo "[simdrive] $*" >&2; }

resolve_udid() {
  local device="${1:-booted}"
  if [ "$device" = "booted" ]; then
    xcrun simctl list devices booted | grep -oE '[0-9A-F-]{36}' | head -1
  elif [[ "$device" =~ ^[0-9A-F-]{36}$ ]]; then
    echo "$device"
  else
    xcrun simctl list devices available \
      | grep -F "$device (" | grep -oE '[0-9A-F-]{36}' | head -1
  fi
}

# The runtime section header above the device's line in `simctl list`
# tells us which destination platform xcodebuild needs.
platform_for_udid() {
  xcrun simctl list devices | awk -v udid="$1" '
    /^-- /          { runtime = $0 }
    index($0, udid) { print (runtime ~ /visionOS|xrOS/) ? "visionOS Simulator" : "iOS Simulator"; exit }'
}

cmd_start() {
  local udid platform
  udid="$(resolve_udid "${1:-booted}")"
  [ -n "$udid" ] || { log "no matching simulator (is one booted?)"; exit 1; }
  platform="$(platform_for_udid "$udid")"

  command -v xcodegen >/dev/null 2>&1 || {
    log "xcodegen not found — install with: brew install xcodegen"
    exit 1
  }
  xcodegen generate >/dev/null

  rm -rf "$DIR"
  mkdir -p "$DIR"
  echo "$udid" > "$DIR/udid"

  # visionOS drops the TEST_RUNNER_* environment injection, so the runner
  # can't learn SIMDRIVE_DIR/SIMDRIVE_APP that way there (#872). Both
  # simulator platforms share the host filesystem, so the settings are
  # also left at a fixed rendezvous path the runner checks when its
  # environment is empty.
  mkdir -p /tmp/simdrive
  printf '{"dir": "%s", "app": "%s"}\n' "$DIR" "$APP" > /tmp/simdrive/config.json

  log "starting runner on $udid ($platform; log: $DIR/xcodebuild.log)"
  # Only the REPL class: the bundle also carries ScrollGestureTests, which is
  # plain arithmetic and has no business running every time a session starts.
  nohup xcodebuild test \
    -project SimDrive.xcodeproj \
    -scheme SimDrive \
    -only-testing:SimDriveUITests/SimDriveTests \
    -destination "platform=$platform,id=$udid" \
    TEST_RUNNER_SIMDRIVE_DIR="$DIR" \
    TEST_RUNNER_SIMDRIVE_APP="$APP" \
    > "$DIR/xcodebuild.log" 2>&1 &
  echo $! > "$DIR/xcodebuild.pid"

  # The runner touches runner.ready once its command loop is up.
  local waited=0
  while [ ! -f "$DIR/runner.ready" ]; do
    sleep 1
    waited=$((waited + 1))
    if [ "$waited" -ge 300 ]; then
      log "runner did not come up in ${waited}s — see $DIR/xcodebuild.log"
      exit 1
    fi
    if ! kill -0 "$(cat "$DIR/xcodebuild.pid")" 2>/dev/null; then
      log "xcodebuild exited before the runner came up — see $DIR/xcodebuild.log"
      exit 1
    fi
  done
  log "ready (${waited}s)"
}

cmd_cmd() {
  [ -d "$DIR" ] || { log "no exchange dir at $DIR — run 'simdrive start' first"; exit 1; }
  local next
  next="$(printf '%04d' "$(( $(ls "$DIR" | grep -cE '^[0-9]{4}\.cmd' || true) + 1 ))")"
  # Write-then-rename so the runner never reads a half-written command.
  printf '%s\n' "$*" > "$DIR/$next.tmp"
  mv "$DIR/$next.tmp" "$DIR/$next.cmd"

  local timeout="${SIMDRIVE_TIMEOUT:-120}" waited=0
  while [ ! -f "$DIR/$next.out" ]; do
    sleep 0.2
    waited=$((waited + 1))
    # A runner that died leaves every queued command unconsumed, so waiting
    # out the full timeout only delays the same answer — and says nothing
    # about why (#902). Report the death instead.
    if [ -f "$DIR/xcodebuild.pid" ] && \
       ! kill -0 "$(cat "$DIR/xcodebuild.pid")" 2>/dev/null; then
      log "runner is gone — command $next was never executed; see $DIR/xcodebuild.log"
      exit 1
    fi
    if [ "$waited" -ge $((timeout * 5)) ]; then
      log "no result for command $next after ${timeout}s"
      exit 1
    fi
  done
  cat "$DIR/$next.out"
  echo
}

cmd_pbcopy() {
  local udid
  udid="$(cat "$DIR/udid" 2>/dev/null || resolve_udid booted)"
  [ -n "$udid" ] || { log "no simulator to target"; exit 1; }
  xcrun simctl pbcopy "$udid"
  log "pasteboard seeded"
}

cmd_stop() {
  if [ -d "$DIR" ]; then
    cmd_cmd quit || true
    # Not our child process, so poll instead of `wait`.
    if [ -f "$DIR/xcodebuild.pid" ]; then
      local pid waited=0
      pid="$(cat "$DIR/xcodebuild.pid")"
      while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 60 ]; do
        sleep 1
        waited=$((waited + 1))
      done
      kill "$pid" 2>/dev/null || true
    fi
  fi
  log "stopped"
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  cmd)    shift; cmd_cmd "$@" ;;
  pbcopy) shift; cmd_pbcopy ;;
  stop)   shift; cmd_stop ;;
  *)
    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
